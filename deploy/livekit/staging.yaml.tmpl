# LiveKit (staging). Separate ports from production so both run side by side;
# media is multiplexed on one UDP port, which is plenty for testing.
port: 7890

rtc:
  tcp_port: 7891
  udp_port: 7892
  # The VPS has its public IP on eth0: advertise only that, no STUN lookup,
  # and never the Docker bridge addresses.
  use_external_ip: false
  interfaces:
    includes:
      - eth0

turn:
  enabled: false

keys:
  __LIVEKIT_API_KEY__: __LIVEKIT_API_SECRET__

room:
  auto_create: true
  empty_timeout: 300
  departure_timeout: 20

logging:
  level: info
