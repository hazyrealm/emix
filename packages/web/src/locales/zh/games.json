  "catalog": {
    "tictactoe": {
      "name": "井字棋",
      "blurb": "三子连线即胜。",
      "rules": "轮流落下你的记号。谁先连成三个（横、竖或斜）谁就赢。棋盘下满仍无连线则为平局。每局轮换先手。"
    },
    "connect4": {
      "name": "四子棋",
      "blurb": "投下棋子，连成四个。",
      "rules": "轮流把棋子投进七列中的一列，棋子会落到最下方的空位。你的四个棋子连成一线（横、竖或斜）即获胜。棋盘满了则为平局。"
    },
    "rps": {
      "name": "石头剪刀布",
      "blurb": "隐藏出拳，三局或五局两胜。",
      "rules": "双方同时出拳，在双方都选好之前，谁也看不到对方的选择。石头赢剪刀，剪刀赢布，布赢石头。30 秒内没有出拳的一方输掉该局。赢得多数局者赢得整场。"
    },
    "chess": {
      "name": "国际象棋",
      "blurb": "经典棋局，可选计时。",
      "rules": "标准国际象棋规则，包括王车易位、吃过路兵和兵升变。将死获胜。逼和、子力不足、三次重复和五十步规则为和棋；你可以提和或认输。使用计时时，时间用完的一方判负。每局交换执子颜色。"
    },
    "checkers": {
      "name": "跳棋",
      "blurb": "美式规则，必须吃子。",
      "rules": "8×8 棋盘上的美式跳棋（英式国际跳棋）。普通棋子沿斜线向前走一格，王棋可沿斜线向任意方向走一格。必须吃子，同一枚棋子能继续跳吃就要继续；可以任选一种吃子路线。棋子到达对方底线即升为王棋，本步结束。无棋可走的一方判负；双方各走 40 步都没有吃子或升王则为和棋。"
    },
    "battleship": {
      "name": "海战棋",
      "blurb": "藏好你的舰队，击沉对方的。",
      "rules": "秘密布置你的五艘船（5、4、3、3 和 2 格）；船可以相邻但不能重叠。然后轮流向对方海域开炮。击沉所有敌舰即获胜。对手只有在你的船被击沉后才能看到它。"
    },
    "memory": {
      "name": "记忆翻牌",
      "blurb": "翻开卡片，找出配对。",
      "rules": "轮到你时翻开两张牌。配对成功得一分并再翻一次；否则两张牌会短暂显示，然后轮到对方。配对最多的玩家获胜。"
    },
    "wordrace": {
      "name": "猜词竞速",
      "blurb": "同一个词，谁更快？",
      "rules": "双方猜同一个五字母单词，每人六次机会。绿色：字母和位置都对。黄色：单词里有这个字母，但位置不对。对手那边你只能看到他猜了几次。先猜中者获胜；都没猜中则为平局。单词为英文。"
    },
    "hangman": {
      "name": "猜单词",
      "blurb": "一个字母一个字母地猜。",
      "rules": "一名玩家出一个单词（或随机单词），另一名玩家猜字母或整个单词。猜错六次则出题者获胜。每局交换角色。单词为英文。"
    },
    "wordduel": {
      "name": "单词对决",
      "blurb": "带分数的单词接龙。",
      "rules": "第一个单词以随机字母开头；之后每个单词都必须以前一个单词的最后一个字母开头。单词至少三个字母且不能重复。每个字母得 1 分，每个 K、V、W、Y 加 1 分，每个 J、Q、X、Z 加 3 分。每人 8 个回合，每回合 30 秒；总分高者获胜。单词为英文。"
    },
    "trivia": {
      "name": "知识竞答",
      "blurb": "2–8 人快速问答。",
      "rules": "所有人在 20 秒内回答同一道题。答对得 500 分，答得越快最多再加 500 分。最后一题结束后，分数最高者获胜。题目为英文。"
    },
    "drawing": {
      "name": "你画我猜",
      "blurb": "一人画，大家猜。",
      "rules": "每一轮每人轮流画一次。画的人从三个词里选一个画出来，其他人输入猜测。猜对得 100 分，速度最多再加 200 分，每有一人猜对，画的人得 50 分。随着时间流逝会逐渐显示字母。最后分数最高者获胜。词语为英文。"
    }
  },
