    },
    "rps": {
      "name": "Камень, ножницы, бумага",
      "blurb": "Скрытый выбор, до 2 или 3 побед.",
      "rules": "Оба выбирают одновременно; никто не видит выбор другого, пока не выберут оба. Камень бьёт ножницы, ножницы бьют бумагу, бумага бьёт камень. Кто не выбрал за 30 секунд, проигрывает раунд. Побеждает тот, кто выиграл большинство раундов."
    },
    "chess": {
      "name": "Шахматы",
      "blurb": "Классика, с часами по желанию.",
      "rules": "Обычные правила шахмат, с рокировкой, взятием на проходе и превращением пешки. Мат — победа. Пат, недостаточно материала, троекратное повторение позиции и правило 50 ходов — ничья; можно предложить ничью или сдаться. С часами проигрывает тот, у кого кончилось время. Цвета меняются каждую партию."
    },
    "checkers": {
      "name": "Шашки",
      "blurb": "Американские правила, бить обязательно.",
      "rules": "Американские шашки на доске 8×8. Простые шашки ходят на одну клетку по диагонали вперёд, дамки — на одну клетку по диагонали в любую сторону. Бить обязательно, и взятие продолжается, пока та же шашка может бить дальше; последовательность взятия выбираете вы. Шашка на последнем ряду становится дамкой, и ход заканчивается. Кому некуда ходить, тот проиграл; 40 ходов каждого без взятий и превращений — ничья."
    },
    "battleship": {
      "name": "Морской бой",
      "blurb": "Спрячьте флот, потопите чужой.",
      "rules": "Тайно расставьте пять кораблей (5, 4, 3, 3 и 2 клетки); корабли могут касаться, но не пересекаться. Затем по очереди стреляйте по полю соперника. Потопите все вражеские корабли, чтобы победить. Соперник видит ваш корабль, только когда он потоплен."
    },
    "memory": {
      "name": "Мемори",
      "blurb": "Открывайте карты, ищите пары.",
      "rules": "В свой ход откройте две карты. Пара даёт очко и ещё один ход; иначе обе карты недолго остаются открытыми, и ход переходит. Побеждает тот, у кого больше пар."
    },
    "wordrace": {
      "name": "Гонка слов",
      "blurb": "Одно слово, кто быстрее?",
      "rules": "Оба угадывают одно и то же слово из пяти букв, по шесть попыток. Зелёный: буква на своём месте. Жёлтый: буква есть в слове, но в другом месте. У соперника видно только число попыток. Кто первым угадает, тот выиграл; если никто — ничья. Слова английские."
    },
    "hangman": {
      "name": "Виселица",
      "blurb": "Угадайте слово по буквам.",
      "rules": "Один игрок загадывает слово (или случайное), другой называет буквы или слово целиком. После шести ошибок выигрывает загадавший. Роли меняются каждую партию. Слова английские."
    },
    "wordduel": {
      "name": "Словесная дуэль",
      "blurb": "Цепочка слов на очки.",
      "rules": "Первое слово начинается со случайной буквы; каждое следующее — с последней буквы предыдущего. В слове не меньше трёх букв, повторять нельзя. Слово приносит очко за букву, +1 за каждую K, V, W или Y и +3 за каждую J, Q, X или Z. У каждого 8 ходов по 30 секунд; побеждает большая сумма. Слова английские."
    },
    "trivia": {
      "name": "Битва знатоков",
      "blurb": "Быстрые вопросы для 2–8 игроков.",
      "rules": "Все отвечают на один вопрос за 20 секунд. Верный ответ даёт 500 очков и до 500 за скорость. После последнего вопроса побеждает тот, у кого больше очков. Вопросы на английском."
    },
    "drawing": {
      "name": "Рисуй и угадывай",
      "blurb": "Один рисует, все угадывают.",
      "rules": "Каждый раунд все рисуют по очереди. Рисующий выбирает одно из трёх слов и рисует его, остальные пишут догадки. Верная догадка даёт 100 очков и до 200 за скорость, а рисующий получает 50 за каждую. По мере хода времени открываются буквы. Побеждает больше всех набравший. Слова английские."
    }
  },
